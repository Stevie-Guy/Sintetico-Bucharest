# Copiază acest fișier în .env și modifică valorile dacă e nevoie:
#   cp .env.example .env
# .env nu se urcă pe GitHub.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=sintetico
POSTGRES_PASSWORD=sintetico
POSTGRES_DB=sintetico
POSTGRES_TEST_DB=sintetico_test

# Porturile de pe calculatorul tău. Schimbă-le dacă ai deja un Postgres local pe 5432.
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# --- Backend (Prisma) ---
# Trebuie să corespundă cu valorile de mai sus.
DATABASE_URL=postgresql://sintetico:sintetico@localhost:5432/sintetico?schema=public
DATABASE_URL_TEST=postgresql://sintetico:sintetico@localhost:5433/sintetico_test?schema=public
