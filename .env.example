# Copiază acest fișier în .env și modifică valorile dacă e nevoie:
#   cp .env.example .env
# .env nu se urcă pe GitHub.

# --- PostgreSQL (docker-compose.yml) ---
# Alege o parolă pentru baza locală și pune aceeași parolă și în DATABASE_URL și DATABASE_URL_TEST.
POSTGRES_USER=sintetico
POSTGRES_PASSWORD=schimba_parola
POSTGRES_DB=sintetico
POSTGRES_TEST_DB=sintetico_test

# Porturile de pe calculatorul tău. Schimbă-le dacă ai deja un Postgres local pe 5432.
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# --- Backend (Prisma) ---
# Trebuie să corespundă cu valorile de mai sus (utilizator, parolă, port, nume bază).
DATABASE_URL=postgresql://sintetico:schimba_parola@localhost:5432/sintetico?schema=public
DATABASE_URL_TEST=postgresql://sintetico:schimba_parola@localhost:5433/sintetico_test?schema=public

# --- Backend (Express) ---
# Portul pe care pornește API-ul.
PORT=3000

# Originile din browser care pot apela API-ul (separate prin virgulă).
# http://localhost:8081 este aplicația Expo pornită cu `npm run web`.
CORS_ORIGINS=http://localhost:8081

# Cât timp e valabilă o sesiune de autentificare, în ore (168 = 7 zile).
SESSION_TTL_HOURS=168

# --- Contul de Administrator ---
# Folosite doar de `npm run create-admin` (în backend/). Completează-le doar în .env, nu aici:
# acest fișier se urcă pe GitHub. Parola respectă regulile de la crearea contului
# (minim 8 caractere, o literă mare, o cifră, un caracter special).
ADMIN_EMAIL=admin@exemplu.ro
ADMIN_PASSWORD=
