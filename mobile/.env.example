# Copiază acest fișier în mobile/.env:
#   cp .env.example .env
# .env nu se urcă pe GitHub.

# Adresa backend-ului. De obicei lasă EXPO_PUBLIC_API_URL goală: în dezvoltare aplicația o
# deduce singură (browser: host-ul paginii; telefon/emulator: IP-ul calculatorului pe care
# rulează Expo), deci merge și după ce schimbi rețeaua Wi-Fi.
# Setează-o doar dacă backend-ul e pe alt calculator sau folosești `expo start --tunnel`.
# Ex.: EXPO_PUBLIC_API_URL=http://192.168.1.10:3000 (emulatorul Android: http://10.0.2.2:3000)
EXPO_PUBLIC_API_URL=
# Portul backend-ului, folosit când adresa se deduce automat.
EXPO_PUBLIC_API_PORT=3000
