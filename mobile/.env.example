# Copiază acest fișier în mobile/.env:
#   cp .env.example .env
# .env nu se urcă pe GitHub.

# Adresa backend-ului. Pe telefon sau emulator NU folosi localhost:
# pune IP-ul calculatorului din rețeaua locală (ex. ipconfig pe Windows).
# Emulatorul Android poate folosi și http://10.0.2.2:3000.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
